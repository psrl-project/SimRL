# =========================================================================
# Project-specific (SimRL)
# =========================================================================
examples/visualization/.*/
unit_tests/nixl/plot/
# Ignore cloned checkouts under third_party/, but keep the installer and pins.
# Use `/*` (not `third_party/`) so files inside can be re-included.
third_party/*
!third_party/install.sh
!third_party/pins.json
third_party_old/
third_party_old_2/
third_party_new/

# Auto-generated Sphinx api docs
/docs/generated

# Misc project data
dataset/*
tensorflow/my_graph/*


# =========================================================================
# Runtime artifacts / outputs (apply anywhere in the repo)
# =========================================================================
# Common artifact file types
**/*.log
**/*.pdf
**/*.pkl
**/*.png
**/*.pt
**/*.ckpt
**/*.tar.gz
**/*.jsonl
**/*.parquet
**/*.lock

# Documentation figures are source assets, not runtime artifacts, so they are
# re-included after the broad file-type rules above.
!docs/_static/img/*.png
!assets/*.png

# Common artifact directories
**/checkpoints
**/wget-log
**/_build/
**/outputs
**/outputs/
**/output/
**/playground
**/wandb
**/logs/
**/log/
**/*log*/
**/models/
**/data/
# The GPU specs YAML is a small static config file (not a dataset) that must ship
# with the package. Git negation cannot re-include a file inside an ignored directory,
# so we un-ignore the directory first, then re-include only the one file.
!srl/cost/kernel/data/
!srl/cost/kernel/data/gpu_specs.yaml


# =========================================================================
# Python: byte-compiled / optimized / DLL files
# =========================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
# Allow the committed pybind11 extension module
!srl/_engine_cpp*.so


# =========================================================================
# Distribution / packaging
# =========================================================================
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
tmp/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST


# =========================================================================
# PyInstaller
#   Usually these files are written by a python script from a template
#   before PyInstaller builds the exe, so as to inject date/other infos.
# =========================================================================
*.manifest
*.spec


